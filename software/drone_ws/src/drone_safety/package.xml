<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_safety</name>
  <version>0.0.0</version>
  <description>Independent safety layer: a system-level supervisor that publishes a verdict, and a pass-through veto that holds the aircraft when that verdict says so.</description>
  <maintainer email="faresespiro535@gmail.com">Fares Espiro</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>drone_interfaces</depend>
  <depend>drone_control</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
