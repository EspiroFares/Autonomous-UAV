<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_bringup</name>
  <version>0.0.0</version>
  <description>Launch files, tuned parameters and the startup script for the full autonomy stack.</description>
  <maintainer email="faresespiro535@gmail.com">Fares Espiro</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>drone_state</exec_depend>                                  
  <exec_depend>drone_behavior</exec_depend>
